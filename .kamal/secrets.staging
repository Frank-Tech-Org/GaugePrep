SECRETS=$(kamal secrets fetch --adapter doppler --from gaugeprep/stg KAMAL_REGISTRY_USERNAME KAMAL_REGISTRY_PASSWORD DATABASE_URL MIGRATION_DATABASE_URL DJANGO_SECRET_KEY WORKER_DATABASE_URL MAIL_HEALTH_TO MAIL_API_KEY)
WORKER_DATABASE_URL=$(kamal secrets extract WORKER_DATABASE_URL $SECRETS)
MAIL_HEALTH_TO=$(kamal secrets extract MAIL_HEALTH_TO $SECRETS)
MAIL_API_KEY=$(kamal secrets extract MAIL_API_KEY $SECRETS)
KAMAL_REGISTRY_USERNAME=$(kamal secrets extract KAMAL_REGISTRY_USERNAME $SECRETS)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
DATABASE_URL=$(kamal secrets extract DATABASE_URL $SECRETS)
MIGRATION_DATABASE_URL=$(kamal secrets extract MIGRATION_DATABASE_URL $SECRETS)
DJANGO_SECRET_KEY=$(kamal secrets extract DJANGO_SECRET_KEY $SECRETS)
