{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaugeprep.com/schemas/content/writing-prompt.schema.json",
  "title": "TCF Canada writing prompt (EE, tasks EE1 to EE3)",
  "description": "Exam specification Section 5. Word ranges are not stored here: they come from the exam rules version.",
  "type": "object",
  "required": [
    "schema",
    "code",
    "version",
    "exam",
    "paper",
    "type",
    "theme",
    "situation",
    "instruction_fr",
    "topic_brief",
    "on_topic_requirements",
    "authoring"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "writing-prompt/1" },
    "code": { "type": "string", "pattern": "^TCF-CA-EE-EE[1-3]-[0-9]{4}$" },
    "version": { "type": "integer", "minimum": 1 },
    "exam": { "const": "TCF_CA" },
    "paper": { "const": "EE" },
    "type": { "type": "string", "enum": ["EE1", "EE2", "EE3"] },
    "theme": { "$ref": "common.schema.json#/$defs/theme" },
    "situation": {
      "type": "string",
      "minLength": 1,
      "description": "The situation in plain English for reviewers and the grader."
    },
    "reader": {
      "type": "object",
      "required": ["who", "relationship", "register"],
      "additionalProperties": false,
      "properties": {
        "who": {
          "type": "string",
          "description": "For example 'your neighbour', 'the readers of the association newsletter'."
        },
        "relationship": {
          "type": "string",
          "enum": [
            "friend_or_family",
            "acquaintance",
            "colleague",
            "superior",
            "service_provider",
            "official",
            "general_public",
            "community_members"
          ]
        },
        "register": {
          "type": "string",
          "enum": ["informal", "neutral", "formal"]
        }
      }
    },
    "points_to_cover": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "Task 1 only: the two or three content points the message must cover."
    },
    "goal": {
      "type": "string",
      "enum": [
        "claim",
        "persuade",
        "reconcile",
        "recommend",
        "inform_and_comment",
        "warn",
        "thank_and_propose"
      ],
      "description": "Task 2 only: the aim of the text."
    },
    "experience": {
      "type": "string",
      "description": "Task 2 only: the experience the learner reports."
    },
    "genre": {
      "type": "string",
      "enum": [
        "message",
        "email",
        "note",
        "letter",
        "article",
        "blog_post",
        "newsletter_article",
        "opinion_text"
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "Task 3 only: two short documents with contrasting views on the same issue.",
      "items": {
        "type": "object",
        "required": ["source", "stance", "text", "word_count"],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "description": "Plausible fictional attribution, for example 'Courrier des lecteurs, Mme Ngo Bayiha, enseignante'."
          },
          "stance": { "type": "string", "enum": ["for", "against", "nuanced"] },
          "text": { "type": "string" },
          "word_count": { "type": "integer", "minimum": 70, "maximum": 110 }
        }
      }
    },
    "instruction_fr": {
      "type": "string",
      "minLength": 1,
      "description": "The learner-facing instruction exactly as shown, in French, ending with the word range taken from the rules, for example '(60 mots minimum, 120 mots maximum)'."
    },
    "topic_brief": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence in English saying what an on-topic answer addresses; input of the topic classifier and the grader."
    },
    "on_topic_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "The checkable elements of task fulfilment, for example 'states the date of the party', 'compares both documents', 'gives own opinion'."
    },
    "target_band": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "common.schema.json#/$defs/cefr" },
      "description": "Lowest and highest level the prompt is designed to discriminate (exam specification 5.1)."
    },
    "authoring": { "$ref": "common.schema.json#/$defs/authoring" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "EE1" } } },
      "then": {
        "required": ["reader", "points_to_cover", "genre"],
        "not": {
          "anyOf": [{ "required": ["documents"] }, { "required": ["goal"] }]
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "EE2" } } },
      "then": {
        "required": ["reader", "goal", "experience", "genre"],
        "not": { "required": ["documents"] }
      }
    },
    {
      "if": { "properties": { "type": { "const": "EE3" } } },
      "then": {
        "required": ["documents", "genre"],
        "not": {
          "anyOf": [
            { "required": ["points_to_cover"] },
            { "required": ["goal"] }
          ]
        }
      }
    }
  ]
}
