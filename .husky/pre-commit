branch=$(git symbolic-ref --short -q HEAD || true)
case "$branch" in
  develop|stage|main)
    echo "pre-commit: refusing to commit on $branch. Work on a feature/*, hotfix/* or chore/* branch." >&2
    exit 1 ;;
esac

# Fail closed: a missing scanner must not let a secret through.
command -v gitleaks >/dev/null 2>&1 || {
  echo "pre-commit: gitleaks is not installed (8.19 or newer needed, for 'gitleaks git --staged')." >&2
  exit 1
}

pnpm exec lint-staged
gitleaks git --staged --redact --no-banner --config .gitleaks.toml
