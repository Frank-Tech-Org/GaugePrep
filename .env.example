# Copy this file to .env for local development.

# Backend (Django). Unset values fall back to the safe local defaults shown here.
# Settings module: config.settings.local | test | dev | staging | production.
DJANGO_SETTINGS_MODULE=config.settings.local
# Dev, staging and production only: generate with `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
DJANGO_SECRET_KEY=
# Comma-separated host names the API answers to; local defaults to localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local: the db service in compose.yaml. Hosted: the Neon connection string for that environment.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linguamentor
# Host ports used by docker compose, change them if 5432 or 8000 is taken.
POSTGRES_PORT=5432
BACKEND_PORT=8000

# Dev and staging server bootstrap (infra/staging/bootstrap.sh), read from the shell of whoever runs it.
# Public half of the SSH key Kamal deploys with: `ssh-keygen -y -f <private key>`. A public key is not a secret.
SERVER_DEPLOY_PUBLIC_KEY=
# Linux user Kamal logs in as; empty means deploy.
SERVER_DEPLOY_USER=
