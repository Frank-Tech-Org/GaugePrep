# Local only. Hosted secrets live in Doppler, project gaugeprep; see the deploy runbook.

# Local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linguamentor
POSTGRES_PORT=5432
# Hosted only, from Doppler (dev, stg): the migration role's URL for the migrate step. Local runs use DATABASE_URL.
MIGRATION_DATABASE_URL=
BACKEND_PORT=8000

# Server bootstrap
SERVER_DEPLOY_PUBLIC_KEY=
SERVER_DEPLOY_USER=
DRY_RUN=
